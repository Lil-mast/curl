# ============================================================
# Maktab AI — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. It is already in .gitignore.
# ============================================================


# ------------------------------------------------------------
# ElevenLabs  (Isaac — services/voice/)
# ------------------------------------------------------------

# Your ElevenLabs secret API key.
# Get it from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice ID for Somali text-to-speech.
# Browse voices at: https://elevenlabs.io/voice-library
# Filter by language to find a respectful-sounding Somali voice.
# Use eleven_v3 model — it has the best multilingual support.
ELEVENLABS_VOICE_ID_SO=

# Voice ID for English text-to-speech.
ELEVENLABS_VOICE_ID_EN=


# ------------------------------------------------------------
# Database  (Faith — services/api/)
# ------------------------------------------------------------

# Neon PostgreSQL connection string.
# Get it from the Neon dashboard → your project → Connection Details.
DATABASE_URL=


# ------------------------------------------------------------
# Flask API  (Alvine — services/api/)
# ------------------------------------------------------------

# Secret key for Flask sessions. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Origins that Flask will allow CORS requests from.
# In development: http://localhost:3000
# In production: your Render Next.js URL
ALLOWED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# Next.js frontend  (apps/web/)
# ------------------------------------------------------------

# Public URL of the Flask API. Next.js uses this to make API calls.
# In development: http://localhost:5000
# In production: your Render Flask URL
# NEXT_PUBLIC_API_URL must start with NEXT_PUBLIC_ to be exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000
