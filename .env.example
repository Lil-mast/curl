# ============================================================
# Maktab AI — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. It is already in .gitignore.
# ============================================================


# ------------------------------------------------------------
# Next.js  (repo root — npm run dev)
# ------------------------------------------------------------

# Public URL of the Flask API. Exposed to the browser.
# Local: http://localhost:5000
# Production: your Render Flask URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Server-side Flask origin used by Next.js API routes (health / knowledge proxy).
# Defaults to NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:5000


# ------------------------------------------------------------
# Live listings  (app/api/listings — Next.js, no secrets)
# ------------------------------------------------------------

# User-Agent sent when fetching public RSS feeds.
LISTINGS_USER_AGENT=MaktabAI/0.1 (listings aggregator for refugees; +https://maktab.local)

# Max listings returned by GET /api/listings
LISTINGS_MAX_ITEMS=40

# Per-feed fetch timeout in milliseconds
LISTINGS_FETCH_MS=8000


# ------------------------------------------------------------
# Flask API  (Alvine — services/api/)
# ------------------------------------------------------------

# Secret key for Flask sessions. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Origins Flask will allow CORS requests from (comma-separated).
# Local: http://localhost:3000
# Production: your Render Next.js URL
ALLOWED_ORIGIN=http://localhost:3000

# Alias of ALLOWED_ORIGIN (either name is accepted).
ALLOWED_ORIGINS=http://localhost:3000

# Flask bind port for local `python -m services.api.app`
PORT=5000


# ------------------------------------------------------------
# Database  (Faith — services/api/)
# ------------------------------------------------------------

# Neon PostgreSQL connection string (pooled URL is fine for runtime).
DATABASE_URL=

# Optional direct (unpooled) URL for migrations and knowledge seed.
DATABASE_DIRECT_URL=
DATABASE_URL_UNPOOLED=


# ------------------------------------------------------------
# ElevenLabs  (Isaac — services/voice/)
# Flask only — never expose these to Next.js.
# ------------------------------------------------------------

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Voice IDs — browse https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID_SO=
ELEVENLABS_VOICE_ID_EN=
